# Server-side only (except the two VITE_SUPABASE_* values). Never prefix secrets with VITE_ (that would bundle them into the browser JS).

# n8n webhook that performs the image fusion
WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/your-webhook-id

# Optional: header auth configured on the n8n Webhook node (Authentication -> Header Auth)
WEBHOOK_AUTH_HEADER=
WEBHOOK_AUTH_VALUE=

# Supabase Auth. These two are public (bundled into the browser JS) and also used by
# the proxy to verify sign-ins. Use the publishable key, never a secret/service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Stripe (public URLs, bundled into the browser JS). The subscription payment link and
# the customer portal login link. Use the live-mode links in production.
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/...
VITE_STRIPE_PORTAL_URL=https://billing.stripe.com/p/login/...

# Stripe webhook (/api/stripe-webhook). Server-side only.
# Signing secret of the webhook endpoint: Stripe Dashboard -> Developers -> Webhooks -> endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# ID of the payment link above (plink_...); checkouts from other links are ignored
STRIPE_PAYMENT_LINK_ID=plink_...
# Supabase secret key (Project Settings -> API Keys -> Secret keys), used only to record subscriptions
SUPABASE_SECRET_KEY=sb_secret_...

# Production server (npm start)
PORT=3000
HOST=127.0.0.1
# Set to true only when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
