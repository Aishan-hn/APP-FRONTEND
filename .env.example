# Server-side only. Never prefix these with VITE_ (that would bundle them into the browser JS).

# n8n webhook that performs the image fusion
WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/your-webhook-id

# Optional: header auth configured on the n8n Webhook node (Authentication -> Header Auth)
WEBHOOK_AUTH_HEADER=
WEBHOOK_AUTH_VALUE=

# Production server (npm start)
PORT=3000
HOST=127.0.0.1
# Set to true only when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
